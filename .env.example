# API
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000

# Ollama
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_PRIMARY_LLM_MODEL=qwen3:8b
RAG_FALLBACK_LLM_MODEL=llama3.2:3b
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_DISABLE_THINKING=true
RAG_OLLAMA_CONNECT_TIMEOUT_SECONDS=8
RAG_OLLAMA_GENERATION_TIMEOUT_SECONDS=300

# Retrieval
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140
RAG_RETRIEVAL_TOP_K=8
RAG_WEB_MAX_RESULTS=6

# Evaluation / revision loop
RAG_EVALUATION_REVISION_THRESHOLD=0.65
RAG_MAX_REVISION_PASSES=1

# Frontend (used by Streamlit)
RAG_API_URL=http://127.0.0.1:8000

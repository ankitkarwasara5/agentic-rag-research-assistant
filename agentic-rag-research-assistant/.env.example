# Optional local configuration. No API keys are required.

RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_API_URL=http://127.0.0.1:8000

# Ollama local runtime
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_PRIMARY_LLM_MODEL=qwen3:8b
RAG_FALLBACK_LLM_MODEL=llama3.2:3b
RAG_EMBEDDING_MODEL=nomic-embed-text

# Apple Silicon / MacBook M3 friendly defaults
RAG_OLLAMA_NUM_CTX=4096
RAG_OLLAMA_NUM_PREDICT=1400
RAG_OLLAMA_NUM_THREAD=8
RAG_OLLAMA_NUM_GPU=1
RAG_OLLAMA_KEEP_ALIVE=10m

# Retrieval and web settings
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_RETRIEVAL_TOP_K=6
RAG_WEB_MAX_RESULTS=5
RAG_WEB_REQUEST_TIMEOUT=12

